graph ER {
  fontname="Helvetica";
  graph [rankdir=LR, splines=spline, nodesep=0.3, ranksep=1.0, pack=true, packmode=array, bgcolor="white", pad=0.3];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#555555"];

  // fókuszban lévő egyedek, minden attribútummal
  "EmployeeStatus" [shape=box, style="filled,bold", fillcolor="#DCE9F7", color="#2E5C8A", penwidth=1.6];
  "EmployeeStatus__employee_status_id" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label=<<U>employee_status_id</U>>];
  "EmployeeStatus" -- "EmployeeStatus__employee_status_id" [len=0.8, weight=4];
  "EmployeeStatus__employee_status_name" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="employee_status_name"];
  "EmployeeStatus" -- "EmployeeStatus__employee_status_name" [len=0.8, weight=4];
  "EmployeeStatus__employee_status_is_active" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="employee_status_is_active"];
  "EmployeeStatus" -- "EmployeeStatus__employee_status_is_active" [len=0.8, weight=4];
  "EmployeeCategories" [shape=box, style="filled,bold", fillcolor="#DCE9F7", color="#2E5C8A", penwidth=1.6];
  "EmployeeCategories__employee_category_id" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label=<<U>employee_category_id</U>>];
  "EmployeeCategories" -- "EmployeeCategories__employee_category_id" [len=0.8, weight=4];
  "EmployeeCategories__employee_category_name" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="employee_category_name"];
  "EmployeeCategories" -- "EmployeeCategories__employee_category_name" [len=0.8, weight=4];
  "CostCenters" [shape=box, style="filled,bold", fillcolor="#DCE9F7", color="#2E5C8A", penwidth=1.6];
  "CostCenters__cost_center_id" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label=<<U>cost_center_id</U>>];
  "CostCenters" -- "CostCenters__cost_center_id" [len=0.8, weight=4];
  "CostCenters__cost_center_name" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="cost_center_name"];
  "CostCenters" -- "CostCenters__cost_center_name" [len=0.8, weight=4];
  "CostCenters__cost_center_code" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="cost_center_code"];
  "CostCenters" -- "CostCenters__cost_center_code" [len=0.8, weight=4];
  "CostCenters__cost_center_next_employee_seq" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="cost_center_next_employee_seq"];
  "CostCenters" -- "CostCenters__cost_center_next_employee_seq" [len=0.8, weight=4];
  "WorkLocations" [shape=box, style="filled,bold", fillcolor="#DCE9F7", color="#2E5C8A", penwidth=1.6];
  "WorkLocations__work_location_id" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label=<<U>work_location_id</U>>];
  "WorkLocations" -- "WorkLocations__work_location_id" [len=0.8, weight=4];
  "WorkLocations__work_location_name" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="work_location_name"];
  "WorkLocations" -- "WorkLocations__work_location_name" [len=0.8, weight=4];
  "WorkLocations__work_location_code" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="work_location_code"];
  "WorkLocations" -- "WorkLocations__work_location_code" [len=0.8, weight=4];
  "WorkLocations__work_location_address_line1" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="work_location_address_line1"];
  "WorkLocations" -- "WorkLocations__work_location_address_line1" [len=0.8, weight=4];
  "WorkLocations__work_location_address_line2" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="work_location_address_line2"];
  "WorkLocations" -- "WorkLocations__work_location_address_line2" [len=0.8, weight=4];
  "WorkLocations__work_location_postal_code" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="work_location_postal_code"];
  "WorkLocations" -- "WorkLocations__work_location_postal_code" [len=0.8, weight=4];
  "WorkLocations__work_location_city" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="work_location_city"];
  "WorkLocations" -- "WorkLocations__work_location_city" [len=0.8, weight=4];
  "WorkLocations__work_location_country" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="work_location_country"];
  "WorkLocations" -- "WorkLocations__work_location_country" [len=0.8, weight=4];

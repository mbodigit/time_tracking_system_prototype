  "GlobalCalendar__gl_cal_id" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label=<<U>gl_cal_id</U>>];
  "GlobalCalendar" -- "GlobalCalendar__gl_cal_id" [len=0.8, weight=4];
  "GlobalCalendar__gl_cal_date" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="gl_cal_date"];
  "GlobalCalendar" -- "GlobalCalendar__gl_cal_date" [len=0.8, weight=4];
  "GlobalCalendar__gl_cal_day_type" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="gl_cal_day_type"];
  "GlobalCalendar" -- "GlobalCalendar__gl_cal_day_type" [len=0.8, weight=4];
  "GlobalCalendar__gl_cal_note" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="gl_cal_note"];
  "GlobalCalendar" -- "GlobalCalendar__gl_cal_note" [len=0.8, weight=4];
  "CompanySettings" [shape=box, style="filled,bold", fillcolor="#DCE9F7", color="#2E5C8A", penwidth=1.6];
  "CompanySettings__company_settings_id" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label=<<U>company_settings_id</U>>];
  "CompanySettings" -- "CompanySettings__company_settings_id" [len=0.8, weight=4];
  "CompanySettings__company_name" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="company_name"];
  "CompanySettings" -- "CompanySettings__company_name" [len=0.8, weight=4];
  "CompanySettings__company_address" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="company_address"];
  "CompanySettings" -- "CompanySettings__company_address" [len=0.8, weight=4];
  "CompanySettings__company_tax_number" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="company_tax_number"];
  "CompanySettings" -- "CompanySettings__company_tax_number" [len=0.8, weight=4];
  "CompanySettings__company_logo_url" [shape=ellipse, style=filled, fillcolor="white", color="#999999", fontsize=8, label="company_logo_url"];
  "CompanySettings" -- "CompanySettings__company_logo_url" [len=0.8, weight=4];

  // kapcsolatok
}

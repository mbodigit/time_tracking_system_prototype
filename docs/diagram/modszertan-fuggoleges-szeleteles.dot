digraph Modszertan {
  graph [rankdir=TB, bgcolor="white", pad=0.35, fontname="Helvetica"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9];

  racs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="white" BORDER="0"></TD><TD BGCOLOR="#3B7A3B" WIDTH="150"><FONT POINT-SIZE="10" COLOR="white"><B>Bejelentkezés és<BR/>jogosultságkezelés</B></FONT></TD><TD BGCOLOR="#E8E8E8" WIDTH="110"><FONT POINT-SIZE="10" COLOR="#777777">Törzsadatok</FONT></TD><TD BGCOLOR="#E8E8E8" WIDTH="110"><FONT POINT-SIZE="10" COLOR="#777777">Dolgozók és<BR/>fiókok</FONT></TD><TD BGCOLOR="#E8E8E8" WIDTH="110"><FONT POINT-SIZE="10" COLOR="#777777">Munkaidő<BR/>rögzítése</FONT></TD><TD BGCOLOR="#E8E8E8" WIDTH="110"><FONT POINT-SIZE="10" COLOR="#777777">Kérelmek</FONT></TD></TR><TR><TD BGCOLOR="#2E5C8A" WIDTH="120" ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="white"><B>ADATBÁZIS</B></FONT></TD><TD BGCOLOR="#DCE9F7" WIDTH="150" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#333333">szerepkörök és a<BR/>jogosultsági mátrix<BR/>feltöltése</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD></TR><TR><TD BGCOLOR="#3B7A3B" WIDTH="120" ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="white"><B>BACKEND</B></FONT></TD><TD BGCOLOR="#DDEEDD" WIDTH="150" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#333333">authController<BR/>authMiddleware<BR/>permissionService</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD></TR><TR><TD BGCOLOR="#A5661F" WIDTH="120" ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="white"><B>FRONTEND</B></FONT></TD><TD BGCOLOR="#FBE6D4" WIDTH="150" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#333333">login-page<BR/>ProtectedRoute<BR/>menüszűrés</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD></TR><TR><TD BGCOLOR="#8A3B3B" WIDTH="120" ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="white"><B>TESZT</B></FONT></TD><TD BGCOLOR="#F6DDDD" WIDTH="150" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#333333">Bruno: 200 / 401 / 403<BR/>és a jelszócsere</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD></TR><TR><TD BGCOLOR="#6B4A7D" WIDTH="120" ALIGN="RIGHT"><FONT POINT-SIZE="9" COLOR="white"><B>DOKUMENTÁCIÓ</B></FONT></TD><TD BGCOLOR="#EFE4F5" WIDTH="150" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#333333">7.1 alfejezet<BR/>szekvenciadiagram</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD><TD BGCOLOR="#FAFAFA" WIDTH="110" HEIGHT="62"><FONT POINT-SIZE="9" COLOR="#BBBBBB">tervezett</FONT></TD></TR></TABLE>>];

  magyarazat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#999999" BGCOLOR="#FFFFFF"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B>Egy sprint egy teljes funkciót készít el, nem egy réteget.</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">A szelet átvágja mind az öt réteget, ezért a sprint végén a funkció használható.<BR ALIGN="LEFT"/>Ha elfogy az idő, kevesebb funkció készül el, de mindegyik teljes — nem marad<BR ALIGN="LEFT"/>félkész rendszer, amelyben van adatbázis, de nincs hozzá felület.</FONT></TD></TR></TABLE>>];

  racs -> magyarazat [style=invis];
}

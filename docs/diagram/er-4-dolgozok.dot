  "R_fk_employee_work_schedule" -- "WorkSchedules" [label="1", len=2.4];
  "R_fk_employee_working_hour" [shape=diamond, style=filled, fillcolor="white", color="#666666", fontsize=8, label="Requires", width=1.0, height=0.55];

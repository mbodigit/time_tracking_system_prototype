  "Employees" -- "R_fk_employee_cost_center" [label="N", len=2.4];
  "R_fk_employee_cost_center" -- "CostCenters" [label="1", len=2.4];
  "R_fk_employee_work_location" [shape=diamond, style=filled, fillcolor="white", color="#666666", fontsize=8, label="WorksAt", width=1.0, height=0.55];
  "Employees" -- "R_fk_employee_work_location" [label="N", len=2.4];
  "R_fk_employee_work_location" -- "WorkLocations" [label="1", len=2.4];
